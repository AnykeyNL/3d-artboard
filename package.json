    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/three": "^0.170.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "clipper-lib": "^6.4.2",
    "earcut": "^3.0.1",
    "fflate": "^0.8.2",
    "three": "^0.170.0"
  }
}
